<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<title>Storage 匯入索引（Super）</title>

<script src="https://www.gstatic.com/firebasejs/9.1.3/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.1.3/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.1.3/firebase-database-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.1.3/firebase-storage-compat.js"></script>

<style>
  body{font-family:"Segoe UI","Microsoft JhengHei",sans-serif;background:#0b1220;color:#fff;margin:0;padding:18px}
  .wrap{max-width:1100px;margin:0 auto}
  .card{background:#121a24;border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:14px;margin:12px 0}
  input,select,button{font-size:16px;border-radius:12px;border:none;padding:10px}
  input{width:100%;box-sizing:border-box}
  button{cursor:pointer;font-weight:900}
  .btn{background:#3498db;color:#fff}
  .btn2{background:#22c55e;color:#08140d}
  .btn3{background:#ef4444;color:#1a0606}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  @media (max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}
  .item{border:1px solid rgba(255,255,255,.10);border-radius:14px;overflow:hidden;background:rgba(255,255,255,.04)}
  .thumb{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#0a0f18}
  .meta{padding:10px}
  .small{opacity:.8;font-size:13px;word-break:break-all}
  .tag{display:inline-block;padding:4px 10px;border-radius:999px;background:rgba(34,197,94,.16);border:1px solid rgba(34,197,94,.22);font-weight:900;font-size:13px}
  .tag.bad{background:rgba(239,68,68,.16);border-color:rgba(239,68,68,.22)}
</style>
</head>

<body>
<div class="wrap">

  <h1 style="margin:6px 0 0;">🧰 Storage → uploadsIndex 匯入工具（Super）</h1>
  <div style="opacity:.85;margin:6px 0 16px;">用途：你目前只有 Storage（gs://），這頁可把圖片補進 RTDB，讓 super.html 能顯示。</div>

  <div class="card" id="loginCard">
    <div style="font-weight:900;margin-bottom:8px;">Super 登入</div>
    <div class="row">
      <input id="email" type="email" placeholder="Email" style="flex:1;min-width:240px;">
      <input id="pass" type="password" placeholder="Password" style="flex:1;min-width:240px;">
      <button class="btn" id="btnLogin">登入</button>
      <button class="btn3" id="btnLogout" style="display:none;">登出</button>
    </div>
    <div id="who" style="margin-top:8px;opacity:.8"></div>
    <div id="msg" style="margin-top:8px;color:#ffb4b4"></div>
  </div>

  <div class="card" id="mainCard" style="display:none;">
    <div style="font-weight:900;margin-bottom:8px;">貼上你的 Storage 路徑（資料夾）</div>

    <div class="row">
      <input id="gsFolder" placeholder="例如：gs://try-something-ddd1e.firebasestorage.app/p1" style="flex:1;min-width:320px;">
      <select id="playerId" style="width:140px;">
        <option value="1">p1</option><option value="2">p2</option><option value="3">p3</option><option value="4">p4</option><option value="5">p5</option><option value="6">p6</option>
        <option value="7">p7</option><option value="8">p8</option><option value="9">p9</option><option value="10">p10</option><option value="11">p11</option>
      </select>
      <button class="btn" id="btnLoad">掃描資料夾</button>
      <button class="btn2" id="btnImportAll" disabled>全部匯入</button>
    </div>

    <div style="margin-top:10px;opacity:.85;">
      匯入會寫入：<b>uploadsIndex</b> + <b>players/pX/uploads</b>（status=pending）
    </div>
  </div>

  <div class="card" id="listCard" style="display:none;">
    <div class="row" style="justify-content:space-between;">
      <div style="font-weight:900;">掃描結果</div>
      <div id="count" style="opacity:.85">-</div>
    </div>
    <div id="grid" class="grid" style="margin-top:10px;"></div>
  </div>

</div>

<script>
  // ===== Firebase init =====
  const firebaseConfig = {
    apiKey: "AIzaSyB0Gvpk5Y6ZermG67lFm-ecaXYGL5pl7mk",
    authDomain: "try-something-ddd1e.firebaseapp.com",
    databaseURL: "https://try-something-ddd1e-default-rtdb.asia-southeast1.firebasedatabase.app",
    projectId: "try-something-ddd1e",
    storageBucket: "try-something-ddd1e.firebasestorage.app",
    messagingSenderId: "245905464126",
    appId: "1:245905464126:web:4aea37e1b2bb0bdd1a2a6f"
  };
  firebase.initializeApp(firebaseConfig);
  const auth = firebase.auth();
  const db   = firebase.database();
  const st   = firebase.storage();

  // 你的 super uid（跟 super.html 一致）
  const SUPER_UID = "AT3xEkjygoZEcCbrG8VdZVklEfj1";

  const $ = (id)=>document.getElementById(id);
  const msg = (t)=>{ $("msg").textContent = t || ""; };

  let scannedItems = []; // {ref, fullPath, url, name, size, contentType}

  $("btnLogin").onclick = async ()=>{
    const email = $("email").value.trim();
    const pass  = $("pass").value;
    if(!email || !pass) return msg("請輸入 Email / Password");
    try{
      msg("");
      await auth.signInWithEmailAndPassword(email, pass);
    }catch(e){
      msg(e?.message || String(e));
    }
  };

  $("btnLogout").onclick = async ()=> auth.signOut();

  auth.onAuthStateChanged((u)=>{
    if(!u){
      $("who").textContent = "";
      $("btnLogout").style.display = "none";
      $("mainCard").style.display = "none";
      $("listCard").style.display = "none";
      return;
    }
    $("who").textContent = `已登入：${u.email} / uid=${u.uid}`;
    $("btnLogout").style.display = "inline-block";

    if(u.uid !== SUPER_UID){
      $("mainCard").style.display = "none";
      $("listCard").style.display = "none";
      msg("你不是 Super（uid 不符），此頁禁止使用。");
      return;
    }
    msg("");
    $("mainCard").style.display = "block";
  });

  async function listFolder(gsFolder){
    // gs://.../p1 這種資料夾
    // 注意：refFromURL 可以吃 gs://
    const folderRef = st.refFromURL(gsFolder);

    // listAll 會回：items（檔案） + prefixes（子資料夾）
    const res = await folderRef.listAll();

    // 合併「當層檔案 + 子資料夾裡的檔案（只抓一層）」：
    const files = [...res.items];

    // 若你 p1 底下還有子資料夾（例如 p1/tasks/...），這邊也順手抓一層
    for(const pre of res.prefixes){
      const r2 = await pre.listAll();
      files.push(...r2.items);
    }

    return files;
  }

  function renderGrid(items){
    $("grid").innerHTML = items.map((x, idx)=>`
      <div class="item">
        <img class="thumb" src="${x.url}" alt="img">
        <div class="meta">
          <div style="font-weight:900;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <span>${x.name}</span>
            <span class="tag" id="tag-${idx}">未匯入</span>
          </div>
          <div class="small">path: ${x.fullPath}</div>
          <div class="row" style="margin-top:8px;">
            <button class="btn2" onclick="importOne(${idx})">匯入</button>
          </div>
        </div>
      </div>
    `).join("");
  }

  async function writeIndex(playerId, fileObj){
    const now = Date.now();
    const ref = db.ref("uploadsIndex").push();
    const uploadId = ref.key;

    const payload = {
      playerId: Number(playerId),
      kind: "photo",
      taskTitle: "",
      taskId: "",
      note: "",
      fileName: fileObj.name || "",
      size: fileObj.size || 0,
      contentType: fileObj.contentType || "",
      storagePath: fileObj.fullPath || "",
      url: fileObj.url || "",
      createdAt: now,
      status: "pending"
    };

    const updates = {};
    updates[`uploadsIndex/${uploadId}`] = payload;
    updates[`players/p${playerId}/uploads/${uploadId}`] = payload;

    await db.ref().update(updates);
    return uploadId;
  }

  // 掛到 window 讓 onclick 可用
  window.importOne = async (idx)=>{
    try{
      const pid = $("playerId").value;
      const x = scannedItems[idx];
      const tag = document.getElementById(`tag-${idx}`);
      if(tag) tag.textContent = "匯入中...";

      await writeIndex(pid, x);

      if(tag){
        tag.textContent = "已匯入";
        tag.classList.remove("bad");
      }
    }catch(e){
      const tag = document.getElementById(`tag-${idx}`);
      if(tag){
        tag.textContent = "失敗";
        tag.classList.add("bad");
      }
      console.error(e);
      alert("匯入失敗：" + (e?.message || e));
    }
  };

  $("btnLoad").onclick = async ()=>{
    const gsFolder = $("gsFolder").value.trim();
    if(!gsFolder.startsWith("gs://")) return alert("請貼 gs:// 開頭的資料夾路徑，例如 gs://.../p1");

    try{
      $("btnImportAll").disabled = true;
      scannedItems = [];
      $("listCard").style.display = "none";
      $("grid").innerHTML = "";
      $("count").textContent = "掃描中...";

      const files = await listFolder(gsFolder);

      // 只抓圖片（你也可放寬）
      const imgFiles = files.filter(f=>{
        const n = (f.name||"").toLowerCase();
        return n.endsWith(".jpg")||n.endsWith(".jpeg")||n.endsWith(".png")||n.endsWith(".webp")||n.endsWith(".gif");
      });

      // 取得 downloadURL
      const arr = [];
      for(const ref of imgFiles){
        const url = await ref.getDownloadURL();
        // metadata 可能需要權限，失敗就跳過
        let meta = {};
        try{ meta = await ref.getMetadata(); }catch(e){}
        arr.push({
          ref,
          name: ref.name,
          fullPath: ref.fullPath,
          url,
          size: meta.size || 0,
          contentType: meta.contentType || ""
        });
      }

      scannedItems = arr;
      $("listCard").style.display = "block";
      $("count").textContent = `共 ${arr.length} 張`;

      renderGrid(arr);
      $("btnImportAll").disabled = (arr.length === 0);

    }catch(e){
      console.error(e);
      alert("掃描失敗：" + (e?.message || e));
    }
  };

  $("btnImportAll").onclick = async ()=>{
    const pid = $("playerId").value;
    if(!scannedItems.length) return;

    if(!confirm(`確定要把 ${scannedItems.length} 張圖片全部匯入到 uploadsIndex（p${pid}）？`)) return;

    for(let i=0;i<scannedItems.length;i++){
      await window.importOne(i);
    }
    alert("全部匯入完成！");
  };
</script>
</body>
</html>