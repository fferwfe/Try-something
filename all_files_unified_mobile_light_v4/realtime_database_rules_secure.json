      ".read": true,
      ".write": "auth != null && auth.uid === 'AT3xEkjygoZEcCbrG8VdZVklEfj1'"
    },
    "joinRequests": {
      ".read": "auth != null && auth.uid === 'AT3xEkjygoZEcCbrG8VdZVklEfj1'",
      ".write": "auth != null && root.child('deviceLocks').child('adminLocked').val() !== true"
    },
    "adminDevices": {
      ".read": true,
